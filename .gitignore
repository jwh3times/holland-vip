# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage
/playwright-report/
/test-results/
/blob-report/
/.playwright/
/.lighthouseci/

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
#
# `.env*.local` alone left `.env` and `.env.production` committable, which is
# the file a wizard or a hurried setup step is most likely to create. Ignore
# every env file and re-admit only the ones that carry names, not values.
.env
.env.*
!.env.example
!.env.tpl

# vercel
.vercel

# typescript
*.tsbuildinfo

# Private Files
private/
/.claude/settings.local.json

# Agent scratch output
/.superpowers/
